APP_VARIANT=production
EXPO_PUBLIC_API_BASE_URL=https://fitician.fit
EXPO_PUBLIC_FRONTEND_ORIGIN=https://fitician.fit
# Android OAuth client ID for com.fitician.app; configure the EAS production
# environment with the client registered for the release signing certificate.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Existing Web OAuth client used only as Android Credential Manager's ID-token audience.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_UPDATES_URL=
EAS_PROJECT_ID=
FITICIAN_APP_LINK_HOST=fitician.fit
