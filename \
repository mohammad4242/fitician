services:
  db:
    image: postgres:18-alpine
    environment:
      POSTGRES_USER: fitician
      POSTGRES_PASSWORD: fitician
      POSTGRES_DB: fitician
    ports:
      - "5432:5432"
    volumes:
      - fitician_postgres_data:/var/lib/postgresql
      - ./docker/postgres/init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U fitician -d fitician"]
      interval: 5s
      timeout: 5s
      retries: 10

  backend:
    build:
      context: ./backend
    env_file:
      - ./backend/.env
    environment:
      DATABASE_URL: postgresql+psycopg://fitician:fitician@db:5432/fitician
      FRONTEND_ORIGIN: http://localhost:5173
      APP_ENV: local
      COOKIE_SECURE: "false"
      SESSION_COOKIE_NAME: fitician_session
      MEDIA_ROOT: /var/lib/fitician/media
      MEDIA_PUBLIC_PATH: /media
      MEDIA_MAX_BYTES: "20971520"
      MEDIA_MAX_VIDEO_DURATION_SECONDS: "20"
    ports:
      - "8001:8000"
    volumes:
      - fitician_exercise_media:/var/lib/fitician/media
    depends_on:
      db:
        condition: service_healthy
    command:
      - sh
      - -c
      - alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000

volumes:
  fitician_postgres_data:
  fitician_exercise_media:
