# Operator template only. Store as /opt/fitician-iran/.env with mode 0600.
# Copy existing production application settings securely; preserve signing/encryption keys.
# Never source this file as shell code or commit the populated file.
COMPOSE_PROJECT_NAME=fitician-iran
FITICIAN_ENV_FILE=/opt/fitician-iran/.env
DOCKERHUB_USERNAME=
IMAGE_TAG=
POSTGRES_VOLUME_NAME=
REDIS_VOLUME_NAME=
CADDY_DATA_VOLUME_NAME=
CADDY_CONFIG_VOLUME_NAME=
POSTGRES_USER=fitician
POSTGRES_DB=fitician
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_PASSWORD=
REDIS_HOST=redis
AGENT_SERVICE_BASE_URL=
AGENT_SERVICE_TOKEN=
AGENT_SERVICE_CONNECT_TIMEOUT_SECONDS=5
FITICIAN_DOMAIN=fitician.fit
APP_ENV=production
FRONTEND_ORIGIN=https://fitician.fit
COOKIE_SECURE=true
SESSION_COOKIE_NAME=__Host-fitician_session
BILLING_DEFAULT_PROVIDER=
BILLING_FAKE_PROVIDER_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_FROM_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMS_PROVIDER=farazsms
FARAZSMS_API_KEY=
FARAZSMS_FROM_NUMBER=
FARAZSMS_PATTERN_CODE=
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
APPLE_CLIENT_ID=
PHONE_OTP_HMAC_SECRET=
PRIVATE_FILE_SIGNING_KEY=
AI_CREDENTIAL_ENCRYPTION_KEY=
MEDIA_STORAGE_BACKEND=s3
MEDIA_LOCAL_FALLBACK_ENABLED=false
MEDIA_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
# Copy enabled FCM/APNs, AI API credentials and provider URLs from current production.
# See root .env.example for all optional fields. Never copy these to Netherlands.
POSTGRES_MEMORY_LIMIT=512m
BACKEND_MEMORY_LIMIT=512m
MIGRATION_MEMORY_LIMIT=256m
BODY_ANALYSIS_WORKER_LEASE_SECONDS=900
FOOD_PHOTO_WORKER_LEASE_SECONDS=600
