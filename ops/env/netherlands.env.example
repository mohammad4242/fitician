# Agent-only settings. Preserve EXISTING token, volume, model allowlists and image SHA.
# Store as /opt/fitician-agent/.env with mode 0600; never commit populated values.
COMPOSE_PROJECT_NAME=fitician-agent
DOCKERHUB_USERNAME=
IMAGE_TAG=
AGENT_HOME_VOLUME_NAME=
AGENT_SERVICE_TOKEN=
AGENT_ANTIGRAVITY_MODELS=[]
AGENT_ANTIGRAVITY_SUPPORTS_IMAGE_INPUT=false
AGENT_CODEX_MODELS=[]
AGENT_CODEX_SUPPORTS_IMAGE_INPUT=true
AGENT_CLAUDE_MODELS=[]
AGENT_CLAUDE_SUPPORTS_IMAGE_INPUT=false
AGENT_MEMORY_LIMIT=448m
AGENT_CPU_LIMIT=0.40
# No S3 credentials, database URL or Iran application env_file here.
