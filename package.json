{
  "name": "fitician-workspace",
  "private": true,
  "packageManager": "npm@11.18.0",
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10.2.6": {
      "brace-expansion": "5.0.12"
    },
    "js-yaml": "4.3.2",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.2"
    },
    "node-forge": "$node-forge",
    "braces": "$braces",
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.7"
    }
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "workspaces": [
    "frontend",
    "mobile",
    "packages/fitician-core"
  ],
  "scripts": {
    "build:core": "npm run build --workspace @fitician/core",
    "test:core": "npm run test --workspace @fitician/core",
    "check:openapi": "node scripts/generate-openapi.mjs --check",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "test:contracts": "node --test scripts/openapi_generation.test.mjs",
    "typecheck:mobile": "npm run typecheck --workspace @fitician/mobile",
    "validate:mobile": "npm run validate --workspace @fitician/mobile",
    "test:mobile:foundation": "node --test mobile/scripts/*.test.mjs",
    "security:secrets": "node mobile/scripts/secret-scan.mjs"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "braces": "file:vendor/braces-3.0.4-fitician.1.tgz",
    "node-forge": "file:vendor/node-forge-1.4.1-fitician.1.tgz"
  }
}
