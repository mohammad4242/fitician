www.{$FITICIAN_DOMAIN} {
	redir https://{$FITICIAN_DOMAIN}{uri} 308
}

{$FITICIAN_DOMAIN} {
	# Bound uploads at ingress; exercise galleries can include multiple 64 MiB videos.
	@exercise_upload path /api/v1/admin/exercises /api/v1/admin/exercises/*
	request_body @exercise_upload {
		max_size 256MiB
	}
	@standard_request not path /api/v1/admin/exercises /api/v1/admin/exercises/*
	request_body @standard_request {
		max_size 32MiB
	}

	handle /healthz {
		reverse_proxy backend:8000 backend-2:8000 {
			health_uri /readyz
			health_interval 10s
			health_timeout 2s
		}
	}

	 handle /api/* {
		reverse_proxy backend:8000 backend-2:8000 {
			health_uri /readyz
			health_interval 10s
			health_timeout 2s
		}
	}

	 handle /media/* {
		reverse_proxy backend:8000 backend-2:8000 {
			health_uri /readyz
			health_interval 10s
			health_timeout 2s
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}
