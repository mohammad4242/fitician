DATABASE_URL=postgresql+psycopg://fitician:fitician@localhost:5432/fitician
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_STATEMENT_TIMEOUT_MS=30000
WORKER_DB_POOL_SIZE=2
WORKER_DB_MAX_OVERFLOW=1
DB_CONNECTION_BUDGET=40
DB_CONNECTION_HEADROOM=4
# Only Caddy/Docker proxy CIDRs. Never use '*' in production.
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12
REDIS_PASSWORD=fitician-redis-local-change-me
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=15
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_DETAIL_TTL_SECONDS=600
CACHE_LOCK_TTL_SECONDS=5
CACHE_LOCK_WAIT_MS=50
FRONTEND_ORIGIN=http://localhost:5173
# Optional comma-separated additional trusted browser origins.
FRONTEND_ORIGINS=
APP_ENV=local
INSTANCE_HEADER_ENABLED=false
# Optional local/test identifier. Production instance headers should stay disabled.
INSTANCE_ID=
COOKIE_SECURE=false
SESSION_COOKIE_NAME=fitician_session
SESSION_TTL_SECONDS=604800
# Media stays local until the S3 adapter and cutover are separately approved.
MEDIA_STORAGE_BACKEND=local
MEDIA_LOCAL_FALLBACK_ENABLED=true
MEDIA_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_PUBLIC_BUCKET=fitician-media
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=60
S3_MAX_ATTEMPTS=3
S3_PUBLIC_OBJECT_ACL=public-read
# Keep account deletion disabled until the product/legal approval record is issued.
ACCOUNT_DELETION_ENABLED=false
ACCOUNT_DELETION_LEGAL_APPROVAL=
ACCOUNT_DELETION_GRACE_PERIOD_DAYS=7
ACCOUNT_DELETION_REAUTH_WINDOW_SECONDS=600
ACCOUNT_DELETION_WORKER_INTERVAL_SECONDS=60
# Signup Trial eligibility and duration are managed by the database AccessCampaign
# (initially launch_trial_v1) through the Admin Subscriptions & Access center.
# Legacy LAUNCH_TRIAL_* environment variables are no longer read.
# Billing is provider-neutral. Fake payments are local/test only.
BILLING_DEFAULT_PROVIDER=fake
BILLING_FAKE_PROVIDER_ENABLED=true
BILLING_ORDER_TTL_MINUTES=30
BILLING_CALLBACK_BASE_URL=
# Authentication delivery providers. Use fake locally/tests; production must use SMTP/Faraz SMS.
EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
PASSWORD_RESET_TTL_SECONDS=900
EMAIL_VERIFICATION_TTL_SECONDS=86400
# Faraz SMS / iranpayamak.com Pattern API.
# Keep real credentials only in backend/.env and never commit them.
SMS_PROVIDER=fake
FARAZSMS_API_KEY=
FARAZSMS_BASE_URL=https://api.iranpayamak.com/ws/v1
FARAZSMS_FROM_NUMBER=
FARAZSMS_PATTERN_CODE=
SMS_TIMEOUT_SECONDS=10
# Backend-only HMAC secret. Production requires at least 32 random characters.
PHONE_OTP_HMAC_SECRET=replace-with-at-least-32-random-characters
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_RESEND_COOLDOWN_SECONDS=60
PHONE_OTP_MAX_ATTEMPTS=5
# Backend Google OAuth client ID used to verify Google ID tokens.
# Keep this set to the Web OAuth client ID used by the working Web sign-in.
GOOGLE_CLIENT_ID=
# Android OAuth client ID for package com.fitician.app and the release signing
# certificate. Set this to the same Android client ID used by the mobile EAS build.
GOOGLE_ANDROID_CLIENT_ID=
# Apple Sign-in is optional. Leave empty until Sign in with Apple is enabled/configured.
APPLE_CLIENT_ID=
# Direct APNs provider. Keep the private key in a protected secret, never in git.
NOTIFICATION_APNS_ENABLED=false
NOTIFICATION_APNS_TEAM_ID=
NOTIFICATION_APNS_KEY_ID=
NOTIFICATION_APNS_PRIVATE_KEY=
NOTIFICATION_APNS_BUNDLE_ID=com.fitician.app
NOTIFICATION_APNS_BASE_URL=https://api.push.apple.com
NOTIFICATION_APNS_TIMEOUT_SECONDS=15
# Authentication abuse-protection limits. Values are requests per window.
AUTH_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_PASSWORD_IP_LIMIT=20
AUTH_PASSWORD_IDENTIFIER_LIMIT=5
AUTH_PHONE_OTP_IP_LIMIT=10
AUTH_PHONE_OTP_IDENTIFIER_LIMIT=10
AUTH_FORGOT_PASSWORD_IP_LIMIT=20
AUTH_FORGOT_PASSWORD_IDENTIFIER_LIMIT=5
AUTH_EMAIL_VERIFICATION_IP_LIMIT=10
AUTH_EMAIL_VERIFICATION_USER_LIMIT=5
AUTH_GOOGLE_IP_LIMIT=30
AUTH_APPLE_IP_LIMIT=30
AUTH_MOBILE_GOOGLE_IP_LIMIT=30
AUTH_MOBILE_APPLE_IP_LIMIT=30
APPLICATION_RATE_LIMIT_WINDOW_SECONDS=3600
BODY_ANALYSIS_RATE_LIMIT=5
BODY_PHOTO_UPLOAD_RATE_LIMIT=30
WORKOUT_GENERATION_RATE_LIMIT=5
MEDIA_ROOT=var/media
MEDIA_PUBLIC_PATH=/media
MEDIA_MAX_BYTES=20971520
MEDIA_MAX_VIDEO_BYTES=67108864
MEDIA_MAX_VIDEO_DURATION_SECONDS=20
FFPROBE_PATH=ffprobe
FFPROBE_TIMEOUT_SECONDS=5
# Owner-video importer. Codex CLI uses its local login; no API key is stored here.
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_SECONDS=60
OWNER_VIDEO_IMPORT_MAX_BYTES=67108864
OWNER_VIDEO_IMPORT_WORK_ROOT=var/imports/owner-video
OWNER_VIDEO_CODEX_PATH=codex
OWNER_VIDEO_CODEX_MODEL=
OWNER_VIDEO_CODEX_TIMEOUT_SECONDS=420
OWNER_VIDEO_IDENTIFICATION_CONFIDENCE=0.90
OWNER_VIDEO_MATCH_CONFIDENCE=0.92
OWNER_VIDEO_PRESENTATION_CONFIDENCE=0.80
# Backend only. Keep a real key in backend/.env; never expose or commit it.
OPENCODE_ZEN_API_KEY=
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_MODEL=gpt-5.6-terra
OPENCODE_ZEN_TIMEOUT_SECONDS=420
# Optional backend-only proxy for Zen, for example socks5://127.0.0.1:10808
OPENCODE_ZEN_PROXY_URL=
OPENROUTER_PROXY_URL=
# Internal Agent Service. Use a random value of at least 32 characters locally;
# never commit the real token. An empty value leaves backend API mode available.
AGENT_SERVICE_BASE_URL=http://agent-service:9001
AGENT_SERVICE_TOKEN=
AGENT_NO_PROXY=agent-service,db,localhost,127.0.0.1
AGENT_SERVICE_CONNECT_TIMEOUT_SECONDS=5
AGENT_SERVICE_MAX_IMAGE_BYTES=8388608
# Temporary Agent Service auth session controls. Credentials persist only in
# the fitician_agent_home Docker volume; active auth sessions stay in memory.
AGENT_AUTH_SESSION_TTL_SECONDS=600
AGENT_AUTH_MAX_OUTPUT_BYTES=65536
# Agent Service model allowlists are Compose variables (JSON arrays). Image support is enabled
# for the pinned CLIs that passed the real container smoke tests.
AGENT_ANTIGRAVITY_MODELS=[]
AGENT_ANTIGRAVITY_SUPPORTS_IMAGE_INPUT=false
AGENT_CODEX_MODELS=[]
AGENT_CODEX_SUPPORTS_IMAGE_INPUT=true
AGENT_CLAUDE_MODELS=[]
AGENT_CLAUDE_SUPPORTS_IMAGE_INPUT=false
# Required only when encrypted provider credentials are stored through admin settings.
AI_CREDENTIAL_ENCRYPTION_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=420
AI_MODEL_CATALOG_TTL_SECONDS=3600
PROFILE_PHOTO_STORAGE_ROOT=var/private/profile-photos
PROFILE_PHOTO_MAX_BYTES=5242880
PROFILE_PHOTO_MAX_PIXELS=16000000
PROFILE_PHOTO_MIN_DIMENSION=128
FOOD_PHOTO_STORAGE_ROOT=var/private/food-photos
FOOD_PHOTO_MAX_BYTES=8388608
FOOD_PHOTO_MAX_PIXELS=20000000
FOOD_PHOTO_RETENTION_DAYS=30
FOOD_PHOTO_RATE_LIMIT=10
# Durable Body Analysis worker settings. The worker uses PostgreSQL leases.
BODY_ANALYSIS_WORKER_BATCH_SIZE=1
BODY_ANALYSIS_WORKER_POLL_SECONDS=3
BODY_ANALYSIS_WORKER_LEASE_SECONDS=900
BODY_ANALYSIS_RETRY_BASE_SECONDS=30
BODY_ANALYSIS_RETRY_MAX_SECONDS=900
NUTRITION_LAB_STORAGE_ROOT=var/private/nutrition-labs
NUTRITION_LAB_MAX_BYTES=12582912
NUTRITION_LAB_MAX_PIXELS=20000000
NUTRITION_LAB_RETENTION_DAYS=2555
NUTRITION_LAB_UPLOAD_RATE_LIMIT=20
NUTRITION_UPLOAD_RATE_WINDOW_SECONDS=3600
PRIVATE_FILE_ACCESS_TTL_SECONDS=300
PRIVATE_FILE_SIGNING_KEY=replace-with-at-least-32-random-characters
WORKOUT_PROMPT_VERSION=v1
WORKOUT_POLICY_VERSION=v1
WORKOUT_CATALOG_PROGRAMMING_VERSION=v1
WORKOUT_MAX_REPAIR_ATTEMPTS=1
WORKOUT_GENERATION_COOLDOWN_SECONDS=300
WORKOUT_MAX_CANDIDATES=80
WORKOUT_MAX_REQUEST_BYTES=262144
WORKOUT_WARMUP_MINUTES=5
# Fitician keeps its own normalized price history. A public provider is optional;
# leave empty until a documented, approved source is configured.
FOOD_PRICE_UPDATE_ENABLED=true
FOOD_PRICE_UPDATE_TIMEZONE=Asia/Tehran
FOOD_PRICE_UPDATE_HOUR=12
FOOD_PRICE_UPDATE_MINUTE=0
FOOD_PRICE_PROVIDER_TIMEOUT_SECONDS=15
FOOD_PRICE_PROVIDER_RETRIES=3
FOOD_PRICE_PUBLIC_SOURCE_URL=
# Future paid provider settings. Empty values are fully supported.
FOOD_PRICE_API_KEY=
FOOD_PRICE_API_BASE_URL=
# Optional credential providers remain disabled until explicitly configured.
FOOD_PRICE_PERSIANAPI_ENABLED=false
FOOD_PRICE_PERSIANAPI_API_KEY=
FOOD_PRICE_BASALAM_API_ENABLED=false
FOOD_PRICE_BASALAM_API_KEY=
FOOD_PRICE_PROVIDER_API_ENABLED=false
FOOD_PRICE_PROVIDER_API_KEY=
FOOD_PRICE_PROVIDER_BASE_URL=

# Optional private monitoring overlay. These ports bind to loopback only.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d
PROMETHEUS_RETENTION_SIZE=1GB
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Secret: set only in the operator environment; never commit a real password.
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-password
JOB_HEARTBEAT_INTERVAL_SECONDS=5
JOB_HEARTBEAT_MAX_AGE_SECONDS=20
VPS_MEMORY_MIB=4096
VPS_CPUS=2
VPS_MINIMUM_HEADROOM_MIB=750
VPS_CPU_OVERSUBSCRIPTION=1.5
POSTGRES_MEMORY_LIMIT=320m
POSTGRES_CPU_LIMIT=0.35
REDIS_MEMORY_LIMIT=192m
REDIS_CPU_LIMIT=0.10
AGENT_MEMORY_LIMIT=448m
AGENT_CPU_LIMIT=0.40
BACKEND_MEMORY_LIMIT=704m
BACKEND_CPU_LIMIT=0.40
BODY_ANALYSIS_WORKER_MEMORY_LIMIT=384m
BODY_ANALYSIS_WORKER_CPU_LIMIT=0.35
FOOD_PHOTO_WORKER_MEMORY_LIMIT=192m
FOOD_PHOTO_WORKER_CPU_LIMIT=0.20
NOTIFICATION_WORKER_MEMORY_LIMIT=96m
NOTIFICATION_WORKER_CPU_LIMIT=0.15
SCHEDULER_MEMORY_LIMIT=128m
SCHEDULER_CPU_LIMIT=0.15
FRONTEND_MEMORY_LIMIT=64m
FRONTEND_CPU_LIMIT=0.05
CADDY_MEMORY_LIMIT=64m
CADDY_CPU_LIMIT=0.10
